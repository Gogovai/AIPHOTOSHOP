# AIPHOTOSHOP environment template
#
# Copy to `.env` (git-ignored) and fill in values as integrations land.
# Nothing secret belongs in this file or in git.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public base URL of the web application (used for absolute links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Design document persistence (Milestone 004 — optional)
#
# When the URL and a key are both provided, the server persists documents to
# Supabase and the editor loads real revisions. Without them the application
# falls back to the in-memory repository, which is the default for local
# development and tests.
#
# SUPABASE_SERVICE_ROLE_KEY is server-only. Never expose it to the browser.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Reserved for later milestones — do not configure yet
# ---------------------------------------------------------------------------
# Milestone 007+ — AI design director
# The AI provider is intentionally undecided; see docs/AI_SYSTEM.md.
# AI_PROVIDER_API_KEY=
